# Ignore all files and directories
/*

# Negative git files
!.gitignore
!.gitconfig

# Negative profile, single file configs
!.bash_profile
!.alacritty.toml
!.vimrc
!.tmux.conf

# Negative subdirs
!*/

# Mistral vibe
/.vibe/logs
/.vibe/plans
/.vibe/.env
/.vibe/vibehistory
/.vibe/vibe.logs

# MacOS $HOME mess
/.idea/
/.ansible/
/.cache/
/.cookiecutter_replay/
/.docker/
/.eclipse/
/.gem/
/.install/
/.kube/
/.kuberlr/
/.local/
/.cursor/
/.minikube/
/.node-gyp/
/.npm/
/.nvm/
/.oh-my-bash/
/.pyenv/
/.rd/
/.ssh/
/.terminfo/
/.terraform.d/
/.vim/
/.vscode/
/.zsh_sessions/
/.cargo/
/.continue/
/.gsutil/
/.cups/
/.putty/
/.gk/
/bin
/Applications/
/Desktop/
/Documents/
/Downloads/
/Library/
/Movies/
/Music/
/Pictures/
/Public/
/go/
/google-cloud-sdk/
/lib/
/nf525/
/rancher-postgres-volume/
/work/
**/*/.DS_Store

# Personnal stuff
/perso

# Filezilla config
/.config/filezilla

# Maven
/.m2

# Unwanted from XDG
/.config/gcloud
/.config/htop
/.config/iterm2
/.config/configstore
/.config/fish
/.config/gtk-2.0
/.config/cursor
/.config/helm
/.config/ngrok

# Lazygit - exclude state file
!/.config/lazygit/**/*.*
/.config/lazygit/state.yml

# Neovim
/.config/nvim/telescope_history
/.config/nvim/plugged/
/.config/nvim/site/autoload/
!/.config/nvim/**/*.*

# LunarVim
!/.config/lvim/**/*.*
/.config/lvim/lazy-lock.json
/.config/lvim/telescope_history
/.config/lvim/mason/
/.config/lunarvim/

# K9S - exclude cluster-specific
!/.config/k9s/**/*.*
/.config/k9s/clusters/**/*.*

# Zed
/.config/zed/**/*.*
!/.config/zed/settings.json


